# ==========================================
# Backend Configuration (.env.example)
# ==========================================

# Application Settings
PROJECT_NAME="QueryNest Multi-Agent Coding Assistant"
VERSION="1.0.0"
DEBUG=true

# Workspace Root Path (leave empty to default to project root)
WORKSPACE_ROOT=

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Provider & Models ("groq" or "gemini")
DEFAULT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# ==========================================
# 1. Redis (Upstash / Redis Cloud / Local)
# ==========================================
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-cluster.upstash.io:6379
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600

# ==========================================
# 2. MongoDB (MongoDB Atlas Cloud)
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/querynest?retryWrites=true&w=majority
MONGO_DB_NAME=querynest

# ==========================================
# 3. PostgreSQL / Supabase / Neon Cloud
# ==========================================
POSTGRES_URL=postgresql://user:password@ep-cool-cloud.us-east-2.aws.neon.tech/querynest?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ==========================================
# Execution & Retry Limits
# ==========================================
MAX_RETRY_COUNT=3
COMMAND_TIMEOUT_SECONDS=30
